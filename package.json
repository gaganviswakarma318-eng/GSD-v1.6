{
  "name": "gs-downloads",
  "version": "1.0.0",
  "description": "Video and Music Downloader",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node backend/server.js",
    "desktop": "electron .",
    "build": "electron-builder",
    "web": "node backend/server.js",
    "test": "node --test"
  },
  "author": "GaganStudio",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.gs.downloads",
    "productName": "GS Downloads",
    "win": {
      "icon": "frontend/assets/favicon/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "backend/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/binaries",
        "to": "binaries"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "keywords": [],
  "type": "commonjs"
}
